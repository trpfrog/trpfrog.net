{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      // A package's `build` script depends on that package's
      // dependencies and devDependencies
      // `build` tasks  being completed first
      // (the `^` symbol signifies `upstream`).
      "dependsOn": ["typegen", "^typegen", "^build", "^pack"],
      // note: output globs are relative to each package's `package.json`
      // (and not the monorepo root)
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "deploy": {
      // A package's `deploy` script depends on the `build`,
      // `test`, and `lint` scripts of the same package
      // being completed. It also has no filesystem outputs.
      "dependsOn": ["build", "test", "lint"]
    },
    "test": {
      "dependsOn": ["^pack"],
      // A package's `test` script should only be rerun when
      // either a `.tsx` or `.ts` file has changed in `src` or `test` folders.
      "inputs": ["src/**/*.tsx", "src/**/*.ts", "test/**/*.ts", "test/**/*.tsx"]
    },
    "typegen": {
      "dependsOn": ["^typegen"]
    },
    // Compiles workspace libraries and Hono RPC clients into `dist/` with
    // source maps and declaration maps. Consumers import these outputs.
    "pack": {
      "dependsOn": ["^pack"],
      "outputs": ["dist/**"]
    },
    // Rebuilds `dist/` on every change. The root `dev` script runs it alongside `dev`.
    // Scripts pass `--no-clean` so `dist/` stays in place while `dev` starts, and
    // Hono clients pass `--watch src` because they reach the server only through
    // `import type`, which the watcher's module graph does not follow.
    "pack:watch": {
      "dependsOn": ["^pack"],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "dependsOn": ["^pack"],
      "cache": false,
      "persistent": true
    }
  }
}
