{
  "name": "@trpfrog.net/content-server",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/client.d.mts",
      "default": "./dist/client.mjs"
    }
  },
  "scripts": {
    "dev": "portless",
    "dev:app": "cf dev",
    "deploy": "vp build --mode ssg && cf deploy",
    "deploy:prod": "vp run deploy",
    "test": "vp test",
    "pack": "vp pack",
    "pack:watch": "vp pack --watch src --no-clean"
  },
  "portless": {
    "name": "content.trpfrog",
    "script": "dev:app"
  },
  "dependencies": {
    "@hono/standard-validator": "catalog:",
    "@trpfrog.net/constants": "workspace:*",
    "@trpfrog.net/posts": "workspace:*",
    "@trpfrog.net/utils": "workspace:*",
    "date-fns": "catalog:",
    "hono": "catalog:",
    "ts-dedent": "catalog:",
    "ts-pattern": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@hono/vite-ssg": "catalog:",
    "@trpfrog.net/config-typescript": "workspace:*",
    "@trpfrog.net/dev-blog-server": "workspace:*",
    "@types/node": "catalog:",
    "cf": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
