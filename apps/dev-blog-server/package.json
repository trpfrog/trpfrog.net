{
  "name": "@trpfrog.net/dev-blog-server",
  "private": true,
  "scripts": {
    "dev": "portless",
    "dev:app": "NODE_ENV=development bun run --hot src/dev-server.ts",
    "build": "tsc",
    "secrets:dev": "op inject --force --in-file .env.local.tpl --out-file .env.local",
    "pack": "vp pack",
    "pack:watch": "vp pack --watch src --no-clean"
  },
  "portless": {
    "name": "md.trpfrog",
    "script": "dev:app"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/client.d.mts",
      "default": "./dist/client.mjs"
    },
    "./ssg-assets": "./src/routes/ssg-assets/index.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "catalog:",
    "@hono/standard-validator": "catalog:",
    "@trpfrog.net/posts": "workspace:*",
    "@trpfrog.net/utils": "workspace:*",
    "@valibot/to-json-schema": "catalog:",
    "ai": "catalog:",
    "clipboardy": "catalog:",
    "chokidar": "catalog:",
    "cloudinary": "catalog:",
    "happy-dom": "catalog:",
    "hono": "catalog:",
    "ts-dedent": "catalog:"
  },
  "devDependencies": {
    "@trpfrog.net/config-typescript": "workspace:*",
    "@trpfrog.net/constants": "workspace:*",
    "@types/bun": "catalog:"
  }
}
